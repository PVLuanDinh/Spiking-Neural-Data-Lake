# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# PyInstaller / .exe build artifacts (only the packaging sources are committed)
build/
dist/
packaging/installer/

# Virtual envs
.venv/
.venv-lake/
.venv-nmnist/
.venv-arm/
**/.venv-*/     # any nested per-subproject venv (e.g. research/neuromorphic_torch/.venv-neuro)
venv/
env/

# Local working docs (not repo artifacts)
*.docx

# Data + model artifacts (not committed — fetched/trained locally)
data/
captures/          # live gesture recordings from record_and_run.ps1
*.pt
*.pth
*.npz
MNIST/

# Terraform (local state + provider cache — never commit state, it can hold sensitive detail)
infra/.terraform/
infra/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars

# Tooling output
graphify-out/
.graphify*/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db
