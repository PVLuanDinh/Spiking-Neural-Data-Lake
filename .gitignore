# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# PyInstaller / .exe build artifacts (only the packaging sources are committed)
build/
dist/
packaging/installer/

# Virtual envs
.venv/
.venv-lake/
.venv-nmnist/
.venv-arm/
# any nested per-subproject venv (e.g. research/neuromorphic_torch/.venv-neuro)
**/.venv-*/
venv/
env/

# Secrets / local env files (API keys etc — never commit)
.env
*.env
**/.env

# Local working docs (not repo artifacts)
*.docx

# Data + model artifacts (not committed — fetched/trained locally)
data/
captures/          # live gesture recordings from record_and_run.ps1
*.pt
*.pth
*.npz
*.npy
MNIST/
lakehouse/

# Terraform (local state + provider cache — never commit state, it can hold sensitive detail)
infra/.terraform/
infra/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars

# Tooling output
graphify-out/
.graphify*/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.turbo/

# Local tool config (mcporter etc.) that lands in the working dir, not a project dir
/config/

# OS
.DS_Store
Thumbs.db

# Local-only — kept on disk, not published to the public repo
/AGENTS.md
/CLAUDE.md
/assets/
/gpu_scaling_sweep.sh
vendor/
models/

# ARC-AGI-3 arcade downloads (research/arc_agi/play.py)
environment_files/
recordings/

# Literature dumps — hundreds of MB of PDFs, kept on disk, never committed
research/ScienceDirect_articles_*/
research/*.zip

# Durable working-memory data lake (chat --web / web_server.py) — persists locally, never committed
brain_data/
