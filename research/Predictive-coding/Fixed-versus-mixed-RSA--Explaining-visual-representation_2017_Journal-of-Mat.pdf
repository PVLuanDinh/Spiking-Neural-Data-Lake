<rdf:Description rdf:about=""> 
<dc:format>application/pdf</dc:format> 
<dc:title>Fixed versus mixed RSA:&#x00A0;Explaining visual representations by fixed and mixed feature sets from shallow and deep computational models</dc:title> 
<dc:creator> 
  <rdf:Seq>
    <rdf:li>Seyed-Mahdi Khaligh-Razavi</rdf:li>
    <rdf:li>Linda Henriksson</rdf:li>
    <rdf:li>Kendrick Kay</rdf:li>
