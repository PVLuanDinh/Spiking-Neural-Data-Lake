  </rdf:Seq>
</dc:creator> 
<dc:subject> 
  <rdf:Bag>
    <rdf:li>Representational similarity analysis</rdf:li>
    <rdf:li>Mixed RSA</rdf:li>
    <rdf:li>Voxel-receptive-field modelling</rdf:li>
    <rdf:li>Object-vision models</rdf:li>
    <rdf:li>Deep convolutional networks</rdf:li>
  </rdf:Bag>
</dc:subject>
<dc:description>Journal of Mathematical Psychology, 76 (2017) 184-197. doi:10.1016/j.jmp.2016.10.007</dc:description>
