<rdf:RDF xmlns:rdf = "http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:pdfx = "http://ns.adobe.com/pdfx/1.3/" xmlns:pdfaid = "http://www.aiim.org/pdfa/ns/id/" xmlns:xap = "http://ns.adobe.com/xap/1.0/" xmlns:xapRights = "http://ns.adobe.com/xap/1.0/rights/" xmlns:dc = "http://purl.org/dc/elements/1.1/" xmlns:dcterms = "http://purl.org/dc/terms/" xmlns:prism = "http://prismstandard.org/namespaces/basic/3.0/" xmlns:ali = "http://www.niso.org/schemas/ali/1.0/" xmlns:jav = "http://www.niso.org/schemas/jav/1.0/" xmlns:crossmark = "http://crossref.org/crossmark/1.0/" >  
<rdf:Description rdf:about=""> 
<dc:format>application/pdf</dc:format> 
<dc:title>Model-based functional neuroimaging using dynamic neural fields: An integrative cognitive neuroscience approach</dc:title> 
<dc:creator> 
  <rdf:Seq>
    <rdf:li>Sobanawartiny Wijeakumar</rdf:li>
    <rdf:li>Joseph P. Ambrose</rdf:li>
    <rdf:li>John P. Spencer</rdf:li>
    <rdf:li>Rodica Curtu</rdf:li>
  </rdf:Seq>
</dc:creator> 
<dc:subject> 
